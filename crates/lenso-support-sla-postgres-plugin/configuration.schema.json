{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "database_url_secret",
    "auth_issuer",
    "auth_assertion_public_key",
    "management_callers",
    "observer_callers",
    "worker_callers",
    "jobs_queue",
    "reconciliation_interval_seconds",
    "max_reconcile_batch"
  ],
  "properties": {
    "schema": { "type": "string", "minLength": 1, "maxLength": 63 },
    "database_url_secret": { "type": "string", "minLength": 1, "maxLength": 512 },
    "auth_issuer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "auth_assertion_public_key": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "management_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "observer_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "worker_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "jobs_queue": { "type": "string", "minLength": 1, "maxLength": 128 },
    "reconciliation_interval_seconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
    "max_reconcile_batch": { "type": "integer", "minimum": 1, "maximum": 200 }
  }
}
